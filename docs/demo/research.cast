[1.654,"o","{\r\n  \"vaultPath\": \"./demo-vault\",\r\n  \"dbPath\": \"./demo-vault\\\\.vault_index.db\",\r\n  \"totalDocuments\": 1,\r\n  \"totalChunks\": 6,\r\n  \"totalTwinPdfs\": 1,\r\n  \"totalVectors\": 6,\r\n  \"incompleteDocuments\": 0,\r\n  \"dbSizeKb\": 270,\r\n  \"totalPdfDocuments\": 1,\r\n  \"pdfReady\": 1,\r\n  \"pdfPending\": 0,\r\n  \"pdfExtracting\": 0,\r\n  \"pdfEmpty\": 0,\r\n  \"pdfFailed\": 0,\r\n  \"pdfStale\": 0,\r\n  \"pdfPages\": 6,\r\n  \"pdfCoverage\": 1,\r\n  \"version\": \"0.3.0-preview.1\",\r\n  \"indexVersion\": \"3-pdf-profiles-citations\",\r\n  \"indexing\": {\r\n    \"state\": \"ready\",\r\n    \"pendingFiles\": 0,\r\n    \"scannedFiles\": 1,\r\n    \"updatedFiles\": 1,\r\n    \"skippedFiles\": 0,\r\n    \"failedFiles\": 0\r\n  },\r\n  \"embedding\": {\r\n    \"state\": \"ready\",\r\n    \"profile\": \"multilingual-e5-small\",\r\n    \"modelId\": \"Xenova/multilingual-e5-small\",\r\n    \"dimensions\": 384,\r\n    \"fingerprint\": \"multilingual-e5-small|Xenova/multilingual-e5-small|mean|384|query: |passage: |norm=l2-weighted|window=unicode-codepoint-recursive|weight=body-effective-tokens|quantized=true\",\r\n    \"cacheDir\": \"<project>/.cache\\\\models\"\r\n  }\r\n}\r\n"]
